# Keep production, preview, and local credentials isolated. Never paste real values here.
NEXT_PUBLIC_PROJECT_NAME=Groundbnb

# PCC-02A preview-only configuration. Fill only in local/Vercel secret stores.
# PCC_DATABASE_URL must target Neon branch br-plain-grass-b8xotge6, database groundbnb.
PCC_DATABASE_URL=
# The exact host component expected in PCC_DATABASE_URL; fail closed on mismatch.
PCC_DATABASE_HOST=
# Server-verified Neon Auth subjects, comma-separated. Empty means all writes denied.
PCC_SPONSOR_SUBJECTS=
# Server-only Neon Auth proxy for the preview/control-center deployment.
# The URL ends /groundbnb/auth and PCC_AUTH_HOST is its exact hostname.
NEON_AUTH_BASE_URL=
PCC_AUTH_HOST=
# Random 32+ character secret, unique to preview. Never commit the value.
NEON_AUTH_COOKIE_SECRET=
