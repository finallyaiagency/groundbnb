# Use distinct values in each environment. Never populate this file with secrets.
# M0 preview Secret template: fill only in Vercel on codex/m0-01-environment-contract.
# postgresql://groundbnb_preview_probe:REPLACE_WITH_PREVIEW_PASSWORD@ep-red-night-b8pf2mdl-pooler.c-14.us-east-1.aws.neon.tech/groundbnb?sslmode=require&channel_binding=require
GROUND_ENV=local
GROUND_DATABASE_URL=postgresql://local_user:replace-me@local-example.neon.tech/groundbnb?sslmode=require
GROUND_DATABASE_HOST=local-example.neon.tech
GROUND_DATABASE_BRANCH_ID=replace-with-local-branch-id
GROUND_AUTH_ISSUER=https://auth-local.example.test
GROUND_AUTH_COOKIE_NAME=groundbnb_local_session
GROUND_PUBLIC_ORIGIN=http://localhost:3000
GROUND_EMAIL_MODE=capture
GROUND_SCHEDULED_WORK=off
GROUND_METERED_DISPATCH=off
GROUND_SEED_MODE=synthetic

# Pins are identifiers, never credentials. Nonproduction must refuse production resources.
GROUND_PRODUCTION_DATABASE_HOST=production-example.neon.tech
GROUND_PRODUCTION_BRANCH_ID=replace-with-production-branch-id
GROUND_PRODUCTION_AUTH_ISSUER=https://auth.example.test
GROUND_PRODUCTION_AUTH_COOKIE_NAME=groundbnb_session
GROUND_PRODUCTION_ORIGIN=https://groundbnb.example.com
# Recovery only: this is the pinned host of the separate control ledger.
# GROUND_RECOVERY_CONTROL_HOST=control-example.neon.tech

# A preview may use a bounded run after approval. Leave these unset by default.
# GROUND_LIVE_TEST_RUN_ID=
# GROUND_LIVE_TEST_START=
# GROUND_LIVE_TEST_UNTIL=
# GROUND_LIVE_TEST_BUDGET_USD=0.25
# GROUND_LIVE_TEST_ACCOUNT_IDS=
# GROUND_LIVE_TEST_RECIPIENTS=
